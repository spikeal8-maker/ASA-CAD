{
  "name": "asa-cad",
  "version": "0.0.0",
  "private": true,
  "description": "Browser-native parametric CAD for ASA Lab",
  "scripts": {
    "install:vendor": "npm --prefix vendor/toubkal ci",
    "dev": "npm --prefix vendor/toubkal run dev",
    "build": "npm --prefix vendor/toubkal run build",
    "lint": "npm --prefix vendor/toubkal run lint",
    "test": "npm --prefix vendor/toubkal test",
    "check": "npm run build && npm run lint && npm test"
  },
  "engines": {
    "node": ">=20.19.0",
    "npm": ">=10.0.0"
  }
}
