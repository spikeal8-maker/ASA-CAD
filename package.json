{
  "name": "asa-cad",
  "version": "0.0.0",
  "private": true,
  "description": "Browser-native parametric CAD for ASA Lab",
  "scripts": {
    "install:vendor": "npm --prefix vendor/toubkal ci",
    "dev": "npm --prefix vendor/toubkal run dev",
    "build": "npm --prefix vendor/toubkal run build",
    "lint": "npm --prefix vendor/toubkal run lint",
    "test:vendor": "npm --prefix vendor/toubkal test",
    "test:m0:part": "node tests/m0/protected-part.mjs",
    "test:m0:licenses": "node tests/m0/license-baseline.mjs",
    "test:m0": "npm run test:m0:part && npm run test:m0:licenses",
    "test": "npm run test:vendor && npm run test:m0",
    "check": "npm run build && npm run lint && npm test",
    "docker:build": "docker compose build",
    "docker:up": "docker compose up --build",
    "docker:down": "docker compose down"
  },
  "engines": {
    "node": ">=20.19.0",
    "npm": ">=10.0.0"
  }
}
