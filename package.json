{
  "name": "asa-cad",
  "version": "0.0.0",
  "private": true,
  "type": "module",
  "description": "Browser-native parametric CAD for ASA Lab",
  "scripts": {
    "install:vendor": "npm --prefix vendor/toubkal ci",
    "dev": "npm --prefix vendor/toubkal run dev",
    "dev:asa": "node build/run-asa-dev.cjs",
    "build": "npm --prefix vendor/toubkal run build",
    "build:asa": "node build/run-asa-build.cjs",
    "lint": "npm --prefix vendor/toubkal run lint",
    "typecheck:asa": "node vendor/toubkal/node_modules/typescript/bin/tsc -p tsconfig.json --noEmit",
    "test:vendor": "npm --prefix vendor/toubkal test",
    "test:m0:part": "node tests/m0/protected-part.mjs",
    "test:m0:licenses": "node tests/m0/license-baseline.mjs",
    "test:m0": "npm run test:m0:part && npm run test:m0:licenses",
    "test:m0d:browser": "node tests/m0d/browser-smoke.mjs",
    "test:m1:architecture": "node tests/m1/architecture.mjs",
    "test:m1:contracts": "node vendor/toubkal/node_modules/tsx/dist/cli.mjs tests/m1/contracts.ts",
    "test:m1:migrations": "node vendor/toubkal/node_modules/tsx/dist/cli.mjs tests/m1/migrations.ts",
    "test:m1:command-registry": "node vendor/toubkal/node_modules/tsx/dist/cli.mjs tests/m1/command-registry.ts",
    "test:m1:application": "node vendor/toubkal/node_modules/tsx/dist/cli.mjs tests/m1/application.ts",
    "test:m1:host": "node vendor/toubkal/node_modules/tsx/dist/cli.mjs tests/m1/host.ts",
    "test:m1:solver": "node vendor/toubkal/node_modules/tsx/dist/cli.mjs tests/m1/sketch-solver.ts",
    "test:m1:measurement": "node vendor/toubkal/node_modules/tsx/dist/cli.mjs tests/m1/measurement.ts",
    "test:m1:runtime": "node vendor/toubkal/node_modules/tsx/dist/cli.mjs tests/m1/protected-part-runtime.ts",
    "test:m1": "npm run typecheck:asa && npm run test:m1:architecture && npm run test:m1:contracts && npm run test:m1:migrations && npm run test:m1:command-registry && npm run test:m1:application && npm run test:m1:host && npm run test:m1:solver && npm run test:m1:measurement && npm run test:m1:runtime",
    "test:m1b:client": "node vendor/toubkal/node_modules/tsx/dist/cli.mjs tests/m1b/client-runtime.ts",
    "test:m1b:asa-host": "node vendor/toubkal/node_modules/tsx/dist/cli.mjs tests/m1b/asa-host.ts",
    "test:m1b:recovery": "node vendor/toubkal/node_modules/tsx/dist/cli.mjs tests/m1b/recovery.ts",
    "test:m1b": "npm run typecheck:asa && npm run test:m1b:client && npm run test:m1b:asa-host && npm run test:m1b:recovery",
    "test:m2:render": "node vendor/toubkal/node_modules/tsx/dist/cli.mjs tests/m2/render-model.ts",
    "test:m2:shell": "npm run typecheck:asa && npm run test:m2:render && npm run build:asa && node tests/m2/shell-build.mjs",
    "test": "npm run test:vendor && npm run test:m0 && npm run test:m1 && npm run test:m1b",
    "check": "npm run build && npm run lint && npm test",
    "docker:build": "docker compose build",
    "docker:up": "docker compose up --build",
    "docker:down": "docker compose down"
  },
  "engines": {
    "node": ">=20.19.0",
    "npm": ">=10.0.0"
  }
}
