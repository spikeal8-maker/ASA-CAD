{
  "compilerOptions": {
    "target": "ES2022",
    "module": "ESNext",
    "moduleResolution": "Bundler",
    "strict": true,
    "noEmit": true,
    "skipLibCheck": true,
    "lib": ["ES2022", "DOM"],
    "typeRoots": ["./vendor/toubkal/node_modules/@types"],
    "forceConsistentCasingInFileNames": true
  },
  "include": ["src/**/*.ts", "tests/m1/**/*.ts"],
  "exclude": ["vendor/**"]
}
