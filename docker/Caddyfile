{
	admin off
	auto_https off
}

:8080 {
	encode zstd gzip

	handle /health/live {
		respond "ok" 200
	}

	# The current imported OpenCascade runtime needs cross-origin isolation.
	# Keep these headers local to the ASA-CAD document/container instead of
	# forcing them onto every ASA Lab page.
	header {
		Cross-Origin-Opener-Policy "same-origin"
		Cross-Origin-Embedder-Policy "require-corp"
		X-Content-Type-Options "nosniff"
		Referrer-Policy "strict-origin-when-cross-origin"
		X-Frame-Options "DENY"
		-Server
	}

	# Production/same-origin mount. `handle_path` strips /cad before looking in
	# /srv, while the release index has <base href="/cad/"> so nested editor and
	# viewer routes resolve every JS/CSS/WASM asset back through this handler.
	handle_path /cad/* {
		root * /srv
		@cad_hashed path_regexp cad_hashed \-[A-Za-z0-9_-]{8,}\.[A-Za-z0-9]+$
		header @cad_hashed Cache-Control "public, max-age=31536000, immutable"
		try_files {path} /index.html
		header Cache-Control "no-cache"
		file_server
	}

	# Standalone root remains available for local inspection. Its release index
	# intentionally loads static assets via /cad/*, proving the production mount
	# path even during standalone testing.
	@hashed path_regexp hashed \-[A-Za-z0-9_-]{8,}\.[A-Za-z0-9]+$
	handle @hashed {
		root * /srv
		header Cache-Control "public, max-age=31536000, immutable"
		file_server
	}

	handle {
		root * /srv
		try_files {path} /index.html
		header Cache-Control "no-cache"
		file_server
	}
}
