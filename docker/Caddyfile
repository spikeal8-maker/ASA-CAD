{
	admin off
	auto_https off
}

:8080 {
	encode zstd gzip

	handle /health/live {
		respond "ok" 200
	}

	# The current imported OpenCascade runtime needs cross-origin isolation.
	# Keep these headers local to the ASA-CAD document/container instead of
	# forcing them onto every ASA Lab page.
	header {
		Cross-Origin-Opener-Policy "same-origin"
		Cross-Origin-Embedder-Policy "require-corp"
		X-Content-Type-Options "nosniff"
		Referrer-Policy "strict-origin-when-cross-origin"
		X-Frame-Options "DENY"
		-Server
	}

	# Rspack emits main.<hash>.js and wasm/opencascade.full.<hash>.wasm. Both
	# dot-hashed and legacy dash-hashed assets are immutable by content hash.
	@cad_hashed path_regexp cad_hashed ^/cad/.*[.-][A-Za-z0-9_-]{8,}\.[A-Za-z0-9]+$
	handle @cad_hashed {
		uri strip_prefix /cad
		root * /srv
		header Cache-Control "public, max-age=31536000, immutable"
		file_server
	}

	# Production/same-origin mount. The release index has <base href="/cad/">,
	# so direct /cad/projects/<id> and /cad/view/<id> refreshes load assets here.
	handle_path /cad/* {
		root * /srv
		try_files {path} /index.html
		header Cache-Control "no-cache"
		file_server
	}

	# Standalone root remains available for local inspection. Its release index
	# intentionally loads static assets via /cad/*, proving production mounting.
	@hashed path_regexp hashed .*[.-][A-Za-z0-9_-]{8,}\.[A-Za-z0-9]+$
	handle @hashed {
		root * /srv
		header Cache-Control "public, max-age=31536000, immutable"
		file_server
	}

	handle {
		root * /srv
		try_files {path} /index.html
		header Cache-Control "no-cache"
		file_server
	}
}
