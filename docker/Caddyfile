{
	admin off
	auto_https off
}

:8080 {
	encode zstd gzip

	handle /health/live {
		respond "ok" 200
	}

	# The current imported OpenCascade runtime needs cross-origin isolation.
	# Keep these headers local to the ASA-CAD document/container instead of
	# forcing them onto every ASA Lab page.
	header {
		Cross-Origin-Opener-Policy "same-origin"
		Cross-Origin-Embedder-Policy "require-corp"
		X-Content-Type-Options "nosniff"
		Referrer-Policy "strict-origin-when-cross-origin"
		X-Frame-Options "DENY"
		-Server
	}

	@hashed path_regexp hashed \-[A-Za-z0-9_-]{8,}\.[A-Za-z0-9]+$
	handle @hashed {
		root * /srv
		header Cache-Control "public, max-age=31536000, immutable"
		file_server
	}

	# Standalone SPA fallback. In the final ASA-CAD shell this also supports
	# direct refreshes of editor/viewer routes.
	handle {
		root * /srv
		try_files {path} /index.html
		header Cache-Control "no-cache"
		file_server
	}
}
