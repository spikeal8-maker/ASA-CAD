diff --git a/tests/m3/sketch-creation-intent.ts b/tests/m3/sketch-creation-intent.ts
new file mode 100644
--- /dev/null
+++ b/tests/m3/sketch-creation-intent.ts
@@ -0,0 +1,220 @@
+import assert from 'node:assert/strict';
+import {
+  CadApplicationImpl, PlaneGCSSketchSolverRuntime, createEmptyCadDocument,
+  parseCadDocument, serializeCadDocument,
+  type CadPartDocument, type CadRuntimeAdapter, type CadRuntimeRecomputeResult,
+  type CadSketchEntityId, type CadSketchId,
+} from '../../src';
+import type { CadCommand, CadCommandResult } from '../../src/contracts/commands';
+
+class NoopSolidRuntime implements CadRuntimeAdapter {
+  async recompute(): Promise<CadRuntimeRecomputeResult> { return { ok: true, diagnostics: [] }; }
+  async captureReference(): Promise<never> { throw new Error('No B-Rep reference is needed for this contract test'); }
+  dispose(): void {}
+}
+
+const solver = new PlaneGCSSketchSolverRuntime();
+await solver.init();
+const apps: CadApplicationImpl[] = [];
+const close = (actual: number, expected: number) => {
+  assert.ok(Math.abs(actual - expected) < 1e-5, String(actual) + ' != ' + String(expected));
+};
+const pointClose = (actual: readonly number[], expected: readonly number[]) => {
+  close(actual[0], expected[0]); close(actual[1], expected[1]);
+};
+const part = (app: CadApplicationImpl): Readonly<CadPartDocument> => {
+  const document = app.getDocument();
+  if (document.kind !== 'part') throw new Error('Expected Part');
+  return document;
+};
+async function execute(app: CadApplicationImpl, command: CadCommand): Promise<CadCommandResult> {
+  const result = await app.execute(command);
+  assert.equal(result.ok, true, result.error?.message);
+  return result;
+}
+async function scene() {
+  const app = new CadApplicationImpl(createEmptyCadDocument('part'), new NoopSolidRuntime());
+  apps.push(app);
+  const result = await execute(app, { id: 'sketch.create', payload: { support: 'XY' } });
+  const sketchId = result.createdIds?.[0] as CadSketchId;
+  assert.ok(sketchId);
+  return { app, sketchId };
+}
+function solved(app: CadApplicationImpl, sketchId: CadSketchId) {
+  const result = solver.solve(app.getDocument(), sketchId);
+  assert.equal(result.ok, true, JSON.stringify(result.diagnostics));
+  assert.equal(result.diagnostics.some((item) => item.severity === 'error'), false, JSON.stringify(result.diagnostics));
+  return result;
+}
+function solvedLine(app: CadApplicationImpl, sketchId: CadSketchId, id: CadSketchEntityId) {
+  const entity = solved(app, sketchId).entities.find((item) => item.id === id);
+  if (entity?.type !== 'line') throw new Error('Expected solved Line');
+  return entity;
+}
+
+try {
+  const { app, sketchId } = await scene();
+  const before = serializeCadDocument(app.getDocument());
+  const created = await execute(app, {
+    id: 'sketch.line',
+    payload: {
+      sketchId, from: [3, 2], to: [33, 20],
+      creationIntent: { start: { kind: 'origin' }, length: 40, direction: { axis: 'x', value: 30 } },
+    },
+  });
+  const firstId = created.createdIds?.[0] as CadSketchEntityId;
+  assert.equal(created.createdIds?.length, 4, 'One Line, one origin relation, two dimensions');
+  let line = solvedLine(app, sketchId, firstId);
+  pointClose(line.data.from, [0, 0]);
+  pointClose(line.data.to, [40 * Math.cos(Math.PI / 6), 20]);
+  assert.equal(part(app).sketches[0].entities.length, 1, 'No hidden axis/reference geometry');
+  const after = serializeCadDocument(app.getDocument());
+  await app.undo();
+  assert.equal(serializeCadDocument(app.getDocument()), before, 'One Undo removes the complete segment intent');
+  await app.redo();
+  assert.equal(serializeCadDocument(app.getDocument()), after, 'Redo restores geometry and all IDs');
+
+  const direction = part(app).dimensions.find((item) => item.type === 'direction');
+  assert.ok(direction);
+  await execute(app, { id: 'part.dimension.setValue', payload: { dimensionId: direction.id, value: 0 } });
+  line = solvedLine(app, sketchId, firstId);
+  pointClose(line.data.to, [40, 0]);
+  await app.undo();
+  line = solvedLine(app, sketchId, firstId);
+  pointClose(line.data.to, [40 * Math.cos(Math.PI / 6), 20]);
+  const beforeSecond = serializeCadDocument(app.getDocument());
+  const second = await execute(app, {
+    id: 'sketch.line', payload: {
+      sketchId, from: line.data.to, to: [line.data.to[0], line.data.to[1] + 10],
+      creationIntent: {
+        start: { kind: 'endpoint', reference: { entityId: firstId, point: 'b' } },
+        orientation: 'vertical', length: 10,
+      },
+    },
+  });
+  const secondId = second.createdIds?.[0] as CadSketchEntityId;
+  pointClose(solvedLine(app, sketchId, secondId).data.from, line.data.to);
+  const completeSecond = serializeCadDocument(app.getDocument());
+  await app.undo();
+  assert.equal(serializeCadDocument(app.getDocument()), beforeSecond);
+  await app.redo();
+  assert.equal(serializeCadDocument(app.getDocument()), completeSecond);
+  const reopened = parseCadDocument(completeSecond);
+  assert.equal(serializeCadDocument(reopened), completeSecond);
+  assert.equal(solver.solve(reopened, sketchId).ok, true);
+
+  for (const intent of [
+    { length: 0 },
+    { direction: { axis: 'x' as const, value: 360 } },
+    { direction: { axis: 'x' as const, value: Number.NaN } },
+    { orientation: 'horizontal' as const, direction: { axis: 'x' as const, value: 0 } },
+  ]) {
+    const prior = serializeCadDocument(app.getDocument());
+    const history = { canUndo: app.getState().canUndo, canRedo: app.getState().canRedo };
+    const rejected = await app.execute({
+      id: 'sketch.line', payload: { sketchId, from: [0, 0], to: [4, 5], creationIntent: { start: { kind: 'origin' }, ...intent } },
+    });
+    assert.equal(rejected.ok, false);
+    assert.equal(serializeCadDocument(app.getDocument()), prior, 'A failed substep leaves no partial segment');
+    assert.deepEqual({ canUndo: app.getState().canUndo, canRedo: app.getState().canRedo }, history);
+  }
+
+  for (const [axis, value] of [['x', 90], ['x', 180], ['x', 270], ['y', 0], ['y', 30]] as const) {
+    const angled = await scene();
+    const radians = (value + (axis === 'y' ? 90 : 0)) * Math.PI / 180;
+    const target = [40 * Math.cos(radians), 40 * Math.sin(radians)] as const;
+    const result = await execute(angled.app, { id: 'sketch.line', payload: {
+      sketchId: angled.sketchId, from: [1, 1], to: [target[0] + 1, target[1] + 1],
+      creationIntent: { start: { kind: 'origin' }, length: 40, direction: { axis, value } },
+    } });
+    const entity = solvedLine(angled.app, angled.sketchId, result.createdIds?.[0] as CadSketchEntityId);
+    pointClose(entity.data.from, [0, 0]); pointClose(entity.data.to, target);
+    assert.equal(part(angled.app).sketches[0].entities.length, 1);
+  }
+
+  const midpoint = await scene();
+  const baseResult = await execute(midpoint.app, { id: 'sketch.line', payload: {
+    sketchId: midpoint.sketchId, from: [0, 0], to: [20, 0],
+    creationIntent: { start: { kind: 'origin' }, orientation: 'horizontal', length: 20 },
+  } });
+  const baseId = baseResult.createdIds?.[0] as CadSketchEntityId;
+  const branchResult = await execute(midpoint.app, { id: 'sketch.line', payload: {
+    sketchId: midpoint.sketchId, from: [11, 1], to: [11, 9],
+    creationIntent: { start: { kind: 'midpoint', entityId: baseId }, orientation: 'vertical', length: 10 },
+  } });
+  const branchId = branchResult.createdIds?.[0] as CadSketchEntityId;
+  pointClose(solvedLine(midpoint.app, midpoint.sketchId, branchId).data.from, [10, 0]);
+  const baseLength = part(midpoint.app).dimensions.find((item) => item.type === 'linear' && item.entityIds[0] === baseId);
+  assert.ok(baseLength);
+  await execute(midpoint.app, { id: 'part.dimension.setValue', payload: { dimensionId: baseLength.id, value: 40 } });
+  pointClose(solvedLine(midpoint.app, midpoint.sketchId, branchId).data.from, [20, 0]);
+  assert.equal(part(midpoint.app).sketches[0].entities.length, 2, 'Midpoint uses native solver relation');
+
+  const ring = await scene();
+  const corners = [[0, 0], [40, 0], [40, 30], [0, 30], [0, 0]] as const;
+  const ringIds: CadSketchEntityId[] = [];
+  for (let index = 0; index < 4; index++) {
+    const result = await execute(ring.app, { id: 'sketch.line', payload: {
+      sketchId: ring.sketchId, from: corners[index], to: corners[index + 1],
+      creationIntent: {
+        start: index === 0 ? { kind: 'origin' }
+          : { kind: 'endpoint', reference: { entityId: ringIds[index - 1], point: 'b' } },
+        end: index === 3 ? { kind: 'endpoint', reference: { entityId: ringIds[0], point: 'a' } } : undefined,
+        orientation: index % 2 === 0 ? 'horizontal' : 'vertical',
+        length: index === 0 ? 40 : index === 1 ? 30 : undefined,
+      },
+    } });
+    ringIds.push(result.createdIds?.[0] as CadSketchEntityId);
+  }
+  const ringSolved = solved(ring.app, ring.sketchId);
+  assert.equal(ringSolved.entities.length, 4);
+  assert.equal(part(ring.app).constraints.filter((item) => item.type === 'coincident').length, 4);
+  for (let index = 0; index < 4; index++) {
+    const edge = solvedLine(ring.app, ring.sketchId, ringIds[index]);
+    pointClose(edge.data.from, corners[index]); pointClose(edge.data.to, corners[index + 1]);
+  }
+
+  for (const clockwise of [false, true]) {
+    const tangent = await scene();
+    const base = await execute(tangent.app, { id: 'sketch.line', payload: {
+      sketchId: tangent.sketchId, from: [0, 0], to: [20, 0],
+      creationIntent: { start: { kind: 'origin' }, orientation: 'horizontal', length: 20 },
+    } });
+    const tangentLineId = base.createdIds?.[0] as CadSketchEntityId;
+    const cy = clockwise ? -5 : 5;
+    const beforeArc = serializeCadDocument(tangent.app.getDocument());
+    const arcResult = await execute(tangent.app, { id: 'sketch.arc', payload: {
+      sketchId: tangent.sketchId, center: [20, cy], start: [20, 0], end: [25, cy], clockwise,
+      creationIntent: {
+        start: { kind: 'endpoint', reference: { entityId: tangentLineId, point: 'b' } },
+        tangentAtStart: true, radius: 5,
+      },
+    } });
+    const arcId = arcResult.createdIds?.[0] as CadSketchEntityId;
+    const arc = solved(tangent.app, tangent.sketchId).entities.find((item) => item.id === arcId);
+    if (arc?.type !== 'arc') throw new Error('Expected tangent Arc');
+    const angle = clockwise ? arc.data.endAngle : arc.data.startAngle;
+    const connection = [
+      arc.data.center[0] + arc.data.radius * Math.cos(angle),
+      arc.data.center[1] + arc.data.radius * Math.sin(angle),
+    ];
+    pointClose(connection, [20, 0]);
+    close(arc.data.radius, 5);
+    close(arc.data.center[0] - connection[0], 0);
+    const coincidence = part(tangent.app).constraints.find((item) => item.type === 'coincident'
+      && item.entityIds.includes(arcId));
+    assert.ok(coincidence?.type === 'coincident');
+    assert.equal(coincidence.data.refs.find((ref) => ref.entityId === arcId)?.point, clockwise ? 'b' : 'a');
+    const afterArc = serializeCadDocument(tangent.app.getDocument());
+    await tangent.app.undo();
+    assert.equal(serializeCadDocument(tangent.app.getDocument()), beforeArc);
+    await tangent.app.redo();
+    assert.equal(serializeCadDocument(tangent.app.getDocument()), afterArc);
+    assert.equal(solver.solve(parseCadDocument(afterArc), tangent.sketchId).ok, true);
+  }
+
+  console.log('Creation intent contract PASS: atomic history, origin, midpoint, direction, closure, tangent Arc, persistence');
+} finally {
+  for (const app of apps) app.dispose();
+  solver.dispose();
+}
diff --git a/tests/m3/sketch-angular-sense.ts b/tests/m3/sketch-angular-sense.ts
new file mode 100644
--- /dev/null
+++ b/tests/m3/sketch-angular-sense.ts
@@ -0,0 +1,182 @@
+import assert from 'node:assert/strict';
+import {
+  CadApplicationImpl, PlaneGCSSketchSolverRuntime, createEmptyCadDocument,
+  migrateCadDocument, parseCadDocument, serializeCadDocument,
+  type CadAngularSense, type CadDimensionId, type CadPartDocument, type CadPoint2,
+  type CadRuntimeAdapter, type CadRuntimeRecomputeResult, type CadSketchEntityId, type CadSketchId,
+} from '../../src';
+import type { CadCommand } from '../../src/contracts/commands';
+
+class NoopSolidRuntime implements CadRuntimeAdapter {
+  async recompute(): Promise<CadRuntimeRecomputeResult> { return { ok: true, diagnostics: [] }; }
+  async captureReference(): Promise<never> { throw new Error('No B-Rep reference in this solver contract test'); }
+  dispose(): void {}
+}
+const solver = new PlaneGCSSketchSolverRuntime();
+await solver.init();
+const apps: CadApplicationImpl[] = [];
+const near = (actual: number, expected: number) => {
+  assert.ok(Math.abs(actual - expected) < 1e-5, String(actual) + ' != ' + String(expected));
+};
+const pointNear = (actual: CadPoint2, expected: CadPoint2) => {
+  near(actual[0], expected[0]); near(actual[1], expected[1]);
+};
+const part = (app: CadApplicationImpl): Readonly<CadPartDocument> => {
+  const document = app.getDocument();
+  if (document.kind !== 'part') throw new Error('Expected Part');
+  return document;
+};
+async function execute(app: CadApplicationImpl, command: CadCommand) {
+  const result = await app.execute(command);
+  assert.equal(result.ok, true, result.error?.message);
+  return result;
+}
+function angular(app: CadApplicationImpl, id: CadDimensionId) {
+  const dimension = part(app).dimensions.find((item) => item.id === id);
+  if (dimension?.type !== 'angular') throw new Error('Expected angular dimension');
+  return dimension;
+}
+
+try {
+  let caseCount = 0;
+  for (const bearing of [0, 35]) for (const value of [30, 120]) {
+    for (const reference of ['forward', 'interior'] as const) for (const branch of ['counterclockwise', 'clockwise'] as const) {
+      const app = new CadApplicationImpl(createEmptyCadDocument('part'), new NoopSolidRuntime());
+      apps.push(app);
+      const created = await execute(app, { id: 'sketch.create', payload: { support: 'XY' } });
+      const sketchId = created.createdIds?.[0] as CadSketchId;
+      const radians = bearing * Math.PI / 180;
+      const end: CadPoint2 = [20 * Math.cos(radians), 20 * Math.sin(radians)];
+      const previous = await execute(app, { id: 'sketch.line', payload: { sketchId, from: [0, 0], to: end } });
+      const previousId = previous.createdIds?.[0] as CadSketchEntityId;
+      await execute(app, { id: 'constraint.fixed', payload: { sketchId, entityId: previousId } });
+      const sense: CadAngularSense = { reference, branch };
+      const sign = branch === 'counterclockwise' ? 1 : -1;
+      const forwardValue = (selectedValue: number) => reference === 'interior' ? 180 - selectedValue : selectedValue;
+      const expectedEnd = (selectedValue: number): CadPoint2 => {
+        const theta = (bearing + sign * forwardValue(selectedValue)) * Math.PI / 180;
+        return [end[0] + 30 * Math.cos(theta), end[1] + 30 * Math.sin(theta)];
+      };
+      const before = serializeCadDocument(app.getDocument());
+      const result = await execute(app, { id: 'sketch.line', payload: {
+        sketchId, from: end, to: expectedEnd(value),
+        creationIntent: {
+          start: { kind: 'endpoint', reference: { entityId: previousId, point: 'b' } },
+          length: 30, angle: { referenceEntityId: previousId, value, angleSense: sense },
+        },
+      } });
+      const nextId = result.createdIds?.[0] as CadSketchEntityId;
+      const angleId = result.createdIds?.[3] as CadDimensionId;
+      assert.equal(result.createdIds?.length, 4, 'One Line, Coincident, length, semantic angle in one command');
+      assert.equal(part(app).sketches[0].entities.length, 2, 'No hidden axis or duplicate model');
+      assert.deepEqual(angular(app, angleId).entityIds, [previousId, nextId], 'Persistence keeps semantic ref order on both branches');
+      assert.deepEqual(angular(app, angleId).angleSense, sense);
+      assert.equal(angular(app, angleId).value, value, 'Display/edit value is the selected measure, never silently complemented');
+
+      const verify = (document: Readonly<CadPartDocument>, alpha: number) => {
+        const solved = solver.solve(document, sketchId);
+        assert.equal(solved.ok, true, JSON.stringify(solved.diagnostics));
+        assert.equal(solved.diagnostics.some((item) => item.severity === 'error'), false);
+        const a = solved.entities.find((item) => item.id === previousId);
+        const b = solved.entities.find((item) => item.id === nextId);
+        if (a?.type !== 'line' || b?.type !== 'line') throw new Error('Expected two real solved Lines');
+        pointNear(a.data.from, [0, 0]); pointNear(a.data.to, end);
+        pointNear(b.data.from, a.data.to); pointNear(b.data.to, expectedEnd(alpha));
+        const ax = a.data.to[0] - a.data.from[0], ay = a.data.to[1] - a.data.from[1];
+        const bx = b.data.to[0] - b.data.from[0], by = b.data.to[1] - b.data.from[1];
+        const turn = Math.atan2(ax * by - ay * bx, ax * bx + ay * by) * 180 / Math.PI;
+        near(turn, sign * forwardValue(alpha));
+        near(180 - Math.abs(turn), reference === 'interior' ? alpha : 180 - alpha);
+      };
+      verify(part(app), value);
+      const complete = serializeCadDocument(app.getDocument());
+      await app.undo();
+      assert.equal(serializeCadDocument(app.getDocument()), before, 'One Undo removes the segment and all three relations');
+      await app.redo();
+      assert.equal(serializeCadDocument(app.getDocument()), complete, 'Redo restores IDs and the angle semantic selector');
+      verify(part(app), value);
+
+      const editedValue = value + 15;
+      await execute(app, { id: 'part.dimension.setValue', payload: { dimensionId: angleId, value: editedValue } });
+      assert.equal(angular(app, angleId).value, editedValue);
+      assert.deepEqual(angular(app, angleId).angleSense, sense, 'Editing native alpha preserves the selected turn branch');
+      verify(part(app), editedValue);
+      const serialized = serializeCadDocument(app.getDocument());
+      const reopened = parseCadDocument(serialized);
+      assert.equal(serializeCadDocument(reopened), serialized, 'Save/Open preserves alpha, selector, semantic ref order and IDs');
+      if (reopened.kind !== 'part') throw new Error('Expected reopened Part');
+      verify(reopened, editedValue);
+      await app.undo();
+      assert.equal(angular(app, angleId).value, value);
+      verify(part(app), value);
+      await app.redo();
+      assert.equal(serializeCadDocument(app.getDocument()), serialized);
+
+      const beforeRejected = serializeCadDocument(app.getDocument());
+      const invalidSense = { reference: 'interior', branch: 'sideways' } as unknown as CadAngularSense;
+      const invalidCommand = await app.execute({ id: 'dimension.angular', payload: {
+        sketchId, aEntityId: previousId, bEntityId: nextId, value, angleSense: invalidSense,
+      } });
+      assert.equal(invalidCommand.ok, false);
+      assert.equal(serializeCadDocument(app.getDocument()), beforeRejected);
+      const invalidCreation = await app.execute({ id: 'sketch.line', payload: {
+        sketchId, from: end, to: expectedEnd(value),
+        creationIntent: { angle: { referenceEntityId: previousId, value, angleSense: sense } },
+      } });
+      assert.equal(invalidCreation.ok, false, 'Relative creation requires the matching previous.b start intent');
+      assert.equal(serializeCadDocument(app.getDocument()), beforeRejected, 'Rejected angle intent leaves no orphan segment');
+
+      const conflictingCreation = await app.execute({ id: 'sketch.line', payload: {
+        sketchId, from: end, to: expectedEnd(value), creationIntent: {
+          start: { kind: 'endpoint', reference: { entityId: previousId, point: 'b' } },
+          orientation: 'horizontal', angle: { referenceEntityId: previousId, value, angleSense: sense },
+        },
+      } });
+      assert.equal(conflictingCreation.ok, false, 'Creation cannot combine inferred orientation and a driving relative angle');
+      assert.equal(serializeCadDocument(app.getDocument()), beforeRejected);
+
+      const malformed = JSON.parse(serialized);
+      malformed.dimensions.find((item: { id: string }) => item.id === angleId).angleSense.branch = 'sideways';
+      assert.throws(() => parseCadDocument(malformed), /angleSense.branch/);
+      const missingBranch = JSON.parse(serialized);
+      delete missingBranch.dimensions.find((item: { id: string }) => item.id === angleId).angleSense.branch;
+      assert.throws(() => parseCadDocument(missingBranch), /angleSense.branch/);
+      const invalidReference = JSON.parse(serialized);
+      invalidReference.dimensions.find((item: { id: string }) => item.id === angleId).angleSense.reference = 'axis';
+      assert.throws(() => parseCadDocument(invalidReference), /angleSense.reference/);
+      for (const schemaVersion of [1, 2, 3]) {
+        const oldGrammar = JSON.parse(serialized);
+        oldGrammar.schemaVersion = schemaVersion;
+        oldGrammar.dimensions[0].angleSense = sense;
+        assert.throws(() => migrateCadDocument(oldGrammar), /angleSense is unsupported/, 'Old grammar cannot smuggle semantic angle fields');
+      }
+      const misplaced = JSON.parse(serialized);
+      misplaced.dimensions[0].angleSense = sense;
+      assert.throws(() => parseCadDocument(misplaced), /angleSense is only valid on angular/);
+
+      const legacy = JSON.parse(serialized);
+      legacy.schemaVersion = 3;
+      const legacyAngle = legacy.dimensions.find((item: { id: string }) => item.id === angleId);
+      delete legacyAngle.angleSense; legacyAngle.value = 60;
+      const migrated = migrateCadDocument(legacy);
+      if (migrated.kind !== 'part') throw new Error('Expected migrated Part');
+      const preserved = migrated.dimensions.find((item) => item.id === angleId);
+      assert.ok(preserved?.type === 'angular');
+      if (preserved?.type !== 'angular') throw new Error('Expected migrated legacy angular dimension');
+      assert.equal(preserved.value, 60, 'Migration never silently changes old forward 60 into native interior 120');
+      assert.equal(preserved.angleSense, undefined);
+      assert.deepEqual(preserved.entityIds, [previousId, nextId]);
+      const legacySolve = solver.solve(migrated, sketchId);
+      assert.equal(legacySolve.ok, true);
+      const legacyLine = legacySolve.entities.find((item) => item.id === nextId);
+      if (legacyLine?.type !== 'line') throw new Error('Expected legacy solved Line');
+      const legacyDirection = (bearing + 60) * Math.PI / 180;
+      pointNear(legacyLine.data.to, [end[0] + 30 * Math.cos(legacyDirection), end[1] + 30 * Math.sin(legacyDirection)]);
+      caseCount += 1;
+    }
+  }
+  console.log('Angular sense contract PASS: ' + caseCount + ' real-solver cases, native alpha, both branches, atomic history, edit, migration and Save/Open');
+} finally {
+  for (const app of apps) app.dispose();
+  solver.dispose();
+}
