@@ -0,0 +1,31 @@
+import type { CadCommandResult } from '../../contracts/commands';
+import type { CadPartDocument } from '../../contracts/document';
+import type { CadDimensionId, CadSketchEntityId, CadSketchId } from '../../contracts/ids';
+import { createCadId } from '../../contracts/ids';
+import { assertCadDirectionValue } from '../../contracts/sketchDimensions';
+import { requireSketch, requireSketchEntity } from './SketchCommandHandlerShared';
+
+export function addDirectionDimension(
+  part: CadPartDocument,
+  sketchId: CadSketchId,
+  entityId: CadSketchEntityId,
+  direction: { axis: 'x' | 'y'; value: number },
+): CadCommandResult {
+  const sketch = requireSketch(part, sketchId);
+  if (requireSketchEntity(sketch, entityId).type !== 'line') {
+    throw new Error('Direction dimension requires a Line entity');
+  }
+  if (direction.axis !== 'x' && direction.axis !== 'y') throw new Error('Direction axis must be x or y');
+  assertCadDirectionValue(direction.value);
+  if (part.dimensions.some((dimension) => dimension.type === 'direction'
+    && dimension.driving && dimension.entityIds[0] === entityId)) {
+    throw new Error('Driving direction dimension already exists for Line');
+  }
+  const id = createCadId<CadDimensionId>('dimension');
+  part.dimensions.push({
+    id, type: 'direction', entityIds: [entityId], axis: direction.axis,
+    value: direction.value, driving: true,
+  });
+  sketch.dimensionIds.push(id);
+  return { ok: true, changed: true, createdIds: [id] };
+}
diff --git a/src/application/commands/SketchCreationIntentOwner.ts b/src/application/commands/SketchCreationIntentOwner.ts
new file mode 100644
--- /dev/null
+++ b/src/application/commands/SketchCreationIntentOwner.ts
@@ -0,0 +1,96 @@
+import type { CadCommandResult } from '../../contracts/commands';
+import type { CadPartDocument } from '../../contracts/document';
+import type { CadSketchEntityId, CadSketchId } from '../../contracts/ids';
+import type {
+  CadSketchArcCreationIntent, CadSketchCurveCreationIntent, CadSketchLineCreationIntent,
+} from '../../contracts/sketchCreation';
+import { assertCadAngularSense } from '../../contracts/sketchDimensions';
+import { addCreationAnchor } from './SketchCreationAnchorOwner';
+import { addDirectionDimension } from './SketchDirectionDimensionOwner';
+import { sketchConstraintCommandHandlers } from './SketchConstraintCommandHandlers';
+import { sketchDimensionCommandHandlers } from './SketchDimensionCommandHandlers';
+
+type CreatedIds = NonNullable<CadCommandResult['createdIds']>;
+
+function collect(ids: CreatedIds, result: CadCommandResult): void {
+  if (!result.ok) throw new Error(result.error?.message ?? 'Creation intent command failed');
+  ids.push(...result.createdIds ?? []);
+}
+
+function applyAnchors(
+  part: CadPartDocument, sketchId: CadSketchId, entityId: CadSketchEntityId,
+  intent: CadSketchCurveCreationIntent, ids: CreatedIds, startPoint: 'a' | 'b',
+): void {
+  const endPoint = startPoint === 'a' ? 'b' : 'a';
+  if (intent.start) collect(ids, addCreationAnchor(part, sketchId, { entityId, point: startPoint }, intent.start));
+  if (intent.end) collect(ids, addCreationAnchor(part, sketchId, { entityId, point: endPoint }, intent.end));
+  if (intent.tangentAtStart) {
+    if (intent.start?.kind !== 'endpoint') throw new Error('Tangent creation requires an existing start endpoint');
+    collect(ids, sketchConstraintCommandHandlers['constraint.tangent'].execute(part, {
+      id: 'constraint.tangent',
+      payload: { sketchId, aEntityId: intent.start.reference.entityId, bEntityId: entityId },
+    }));
+  }
+}
+
+/**
+ * Called only inside the owning geometry command. No nested application.execute:
+ * its existing before-snapshot covers the geometry and every inferred relation.
+ */
+export function completeLineCreation(
+  part: CadPartDocument, sketchId: CadSketchId, entityId: CadSketchEntityId,
+  intent?: CadSketchLineCreationIntent,
+): CadCommandResult {
+  const ids: CreatedIds = [entityId];
+  if (!intent) return { ok: true, changed: true, createdIds: ids };
+  if ([intent.orientation, intent.direction, intent.angle].filter((value) => value !== undefined).length > 1) {
+    throw new Error('Choose one inferred orientation, axis direction or relative angle');
+  }
+  if (intent.angle !== undefined) {
+    if (!intent.angle || intent.start?.kind !== 'endpoint' || intent.start.reference.point !== 'b'
+      || intent.start.reference.entityId !== intent.angle.referenceEntityId) {
+      throw new Error('Creation angle requires start at its reference Line.b');
+    }
+    assertCadAngularSense(intent.angle.angleSense, 'Creation angle.angleSense');
+  }
+  applyAnchors(part, sketchId, entityId, intent, ids, 'a');
+  if (intent.orientation === 'horizontal') {
+    collect(ids, sketchConstraintCommandHandlers['constraint.horizontal'].execute(part, {
+      id: 'constraint.horizontal', payload: { sketchId, entityId },
+    }));
+  } else if (intent.orientation === 'vertical') {
+    collect(ids, sketchConstraintCommandHandlers['constraint.vertical'].execute(part, {
+      id: 'constraint.vertical', payload: { sketchId, entityId },
+    }));
+  } else if (intent.orientation !== undefined) {
+    throw new Error('Creation orientation must be horizontal or vertical');
+  }
+  if (intent.length !== undefined) {
+    collect(ids, sketchDimensionCommandHandlers['dimension.linear'].execute(part, {
+      id: 'dimension.linear', payload: { sketchId, entityIds: [entityId], value: intent.length },
+    }));
+  }
