diff --git a/src/application/commands/SketchCreationAnchorOwner.ts b/src/application/commands/SketchCreationAnchorOwner.ts
new file mode 100644
--- /dev/null
+++ b/src/application/commands/SketchCreationAnchorOwner.ts
@@ -0,0 +1,51 @@
+import type { CadCommandResult } from '../../contracts/commands';
+import type { CadPartDocument } from '../../contracts/document';
+import type { CadConstraintId, CadSketchId } from '../../contracts/ids';
+import { createCadId } from '../../contracts/ids';
+import type { CadSketchCreationAnchor, CadSketchEndpointReference } from '../../contracts/sketchCreation';
+import { requireSketch, requireSketchEntity } from './SketchCommandHandlerShared';
+import { addCoincidentConstraint } from './SketchCoincidentConstraintOwner';
+
+/** Application-owned creation anchors; source geometry remains the input seed. */
+export function addCreationAnchor(
+  part: CadPartDocument,
+  sketchId: CadSketchId,
+  source: CadSketchEndpointReference,
+  anchor: CadSketchCreationAnchor,
+): CadCommandResult {
+  const sketch = requireSketch(part, sketchId);
+  const entity = requireSketchEntity(sketch, source.entityId);
+  if ((entity.type !== 'line' && entity.type !== 'arc') || (source.point !== 'a' && source.point !== 'b')) {
+    throw new Error('Creation anchor source must be a Line or Arc endpoint');
+  }
+  if (anchor.kind === 'endpoint') {
+    return addCoincidentConstraint(part, sketchId, [source, anchor.reference]);
+  }
+  if (anchor.kind !== 'origin' && anchor.kind !== 'midpoint') {
+    throw new Error('Unsupported creation anchor kind');
+  }
+  if (anchor.kind === 'midpoint') {
+    const target = requireSketchEntity(sketch, anchor.entityId);
+    if (target.type !== 'line' || target.id === source.entityId) {
+      throw new Error('Midpoint target must be a distinct Line in the same Sketch');
+    }
+  }
+  const ids = new Set(sketch.constraintIds);
+  const duplicate = part.constraints.some((constraint) => {
+    if (!ids.has(constraint.id)) return false;
+    if (constraint.type !== 'originCoincident' && constraint.type !== 'midpoint') return false;
+    if (constraint.data.source.entityId !== source.entityId || constraint.data.source.point !== source.point) return false;
+    return anchor.kind === 'origin'
+      ? constraint.type === 'originCoincident'
+      : constraint.type === 'midpoint' && constraint.entityIds[1] === anchor.entityId;
+  });
+  if (duplicate) throw new Error('Creation anchor constraint already exists');
+  const id = createCadId<CadConstraintId>('constraint');
+  if (anchor.kind === 'origin') {
+    part.constraints.push({ id, type: 'originCoincident', entityIds: [source.entityId], data: { source: { ...source } } });
+  } else {
+    part.constraints.push({ id, type: 'midpoint', entityIds: [source.entityId, anchor.entityId], data: { source: { ...source } } });
+  }
+  sketch.constraintIds.push(id);
+  return { ok: true, changed: true, createdIds: [id] };
+}
